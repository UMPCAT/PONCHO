<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0a6675">
  <meta name="description" content="Aplicación operativa PONCHO 2026 · Equipo NOA Oeste · Medios de Pago">
  <title>PONCHO 2026 · Equipo NOA Oeste</title>

  <!-- En este repositorio los archivos están en la raíz. -->
  <link rel="stylesheet" href="./style.css?v=3">
  <link rel="manifest" href="./manifest.webmanifest">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" defer></script>

  <script>
    /* Reemplazar por la URL /exec de la implementación de Google Apps Script. */
    window.APPS_SCRIPT_URL = "PEGAR_AQUI_LA_URL_DE_APPS_SCRIPT";
  </script>
  <script src="./app.js?v=3" defer></script>
</head>
<body>
  <div class="app-shell">
    <header class="topbar">
      <button class="icon-btn back-btn" id="btnBack" type="button" aria-label="Volver">←</button>
      <div class="brand-lockup" aria-label="Banco Nación · PONCHO 2026">
        <img class="bna-logo" src="./assets/logo-bna.png" alt="Banco Nación">
        <div class="brand-text">
          <strong>PONCHO 2026</strong>
          <span>Equipo NOA Oeste · Medios de Pago</span>
        </div>
      </div>
      <button class="agent-chip" id="chipAgente" type="button" hidden title="Cambiar agente"></button>
    </header>

    <main>
      <section class="hero-panel" aria-label="Fiesta Nacional e Internacional del Poncho 2026">
        <img class="hero-banner" src="./assets/banner-poncho-marcaton.png" alt="Fiesta Nacional e Internacional del Poncho · Edición N.º 55 · El Marcatón">
        <div class="hero-event">
          <div class="hero-copy">
            <span class="eyebrow">PONCHO 2026 · EDICIÓN N.º 55</span>
            <h1>Gestión operativa en tiempo real</h1>
            <p>Comercios, acciones comerciales y dashboard online.</p>
          </div>
        </div>
      </section>

      <div id="configAlert" class="config-alert" hidden>
        <strong>Falta conectar la app.</strong>
        Pegá en <code>index.html</code> la URL de Apps Script que termina en <code>/exec</code>.
      </div>

      <!-- ENROLAMIENTO -->
      <section class="screen active" id="screen-enrolamiento" aria-labelledby="titulo-enrolamiento">
        <div class="section-heading">
          <span class="step">01</span>
          <div>
            <h2 id="titulo-enrolamiento">Registro de agente</h2>
            <p>Se solicita una sola vez por dispositivo.</p>
          </div>
        </div>
        <div class="card form-card">
          <label for="inApellidoNombre">Apellido y nombre</label>
          <input id="inApellidoNombre" type="text" autocomplete="name" maxlength="80" placeholder="Ej.: Pérez, Juan">

          <div class="form-grid two-cols">
            <div>
              <label for="inLegajo">Legajo (5 números)</label>
              <input id="inLegajo" type="text" inputmode="numeric" autocomplete="off" maxlength="5" placeholder="Ej.: 12345">
            </div>
            <div>
              <label for="inSucursal">Sucursal</label>
              <select id="inSucursal">
                <option value="">Seleccionar…</option>
                <option>Fray Mamerto Esquiú</option>
                <option>SFV de Catamarca</option>
                <option>Villa Dolores</option>
                <option>Medios de Pago</option>
                <option>Otros</option>
              </select>
            </div>
          </div>

          <button class="btn btn-primary" id="btnEnrolar" type="button">Ingresar a la app</button>
          <div class="msg" id="msgEnrolamiento" role="status" aria-live="polite"></div>
        </div>
      </section>

      <!-- MENU -->
      <section class="screen" id="screen-menu" aria-labelledby="titulo-menu">
        <div class="section-heading">
          <span class="step">02</span>
          <div>
            <h2 id="titulo-menu">Menú principal</h2>
            <p>Elegí la gestión que vas a realizar.</p>
          </div>
        </div>
        <div class="grid-menu">
          <button class="menu-card" type="button" data-go="comercios">
            <span class="menu-icon">⌂</span><strong>Comercios</strong><span>Consultar, validar y señalizar</span>
          </button>
          <button class="menu-card" type="button" data-go="personas">
            <span class="menu-icon">＋</span><strong>Personas</strong><span>Registrar acciones y entregas</span>
          </button>
          <button class="menu-card wide" type="button" data-go="dashboard">
            <span class="menu-icon">▥</span><strong>Dashboard</strong><span>Seguimiento online y métricas del evento</span>
          </button>
        </div>
      </section>

      <!-- COMERCIOS -->
      <section class="screen" id="screen-comercios" aria-labelledby="titulo-comercios">
        <div class="section-heading">
          <span class="step">C</span>
          <div><h2 id="titulo-comercios">Comercios</h2><p>Buscá por CUIT/CUIL, razón social o nombre de fantasía.</p></div>
        </div>
        <div class="card search-card">
          <label for="inBuscarComercio">CUIT/CUIL, razón social o nombre de fantasía</label>
          <div class="search-row">
            <input id="inBuscarComercio" type="search" autocomplete="off" placeholder="Ej.: 30-12345678-9, razón social o nombre del comercio">
            <button class="btn btn-primary compact" id="btnBuscarComercio" type="button">Buscar</button>
          </div>
          <small>La búsqueda no distingue mayúsculas, tildes ni guiones.</small>
        </div>
        <div id="resultadosComercios" class="results-stack" aria-live="polite"></div>
      </section>

      <!-- PERSONAS -->
      <section class="screen" id="screen-personas" aria-labelledby="titulo-personas">
        <div class="section-heading">
          <span class="step">P</span>
          <div><h2 id="titulo-personas">Personas</h2><p>Seleccioná el tipo de acción.</p></div>
        </div>
        <div class="list-submenu" id="listaSubmenus"></div>
      </section>

      <!-- FORMULARIO PERSONAS -->
      <section class="screen" id="screen-form-personas" aria-labelledby="tituloForm">
        <div class="section-heading">
          <span class="step">P</span>
          <div><h2 id="tituloForm">Formulario</h2><p id="subtituloForm">Completá todos los campos.</p></div>
        </div>
        <div class="card form-card">
          <form id="formPersonas" novalidate></form>
          <div class="msg" id="msgPersonas" role="status" aria-live="polite"></div>
        </div>
      </section>

      <!-- DASHBOARD -->
      <section class="screen" id="screen-dashboard" aria-labelledby="titulo-dashboard">
        <div class="section-heading dashboard-heading">
          <span class="step">D</span>
          <div><h2 id="titulo-dashboard">Dashboard</h2><p>Información consolidada en línea.</p></div>
          <button class="btn btn-secondary compact" id="btnRefrescarDashboard" type="button">Actualizar</button>
        </div>

        <div class="dashboard-status" id="dashboardStatus"></div>
        <div class="kpis" id="kpis"></div>

        <div class="dashboard-grid">
          <article class="card chart-card chart-wide">
            <div class="card-heading"><h3>Registros por módulo</h3><span>Total acumulado</span></div>
            <canvas id="chartModulos" height="150"></canvas>
          </article>
          <article class="card chart-card chart-wide">
            <div class="card-heading"><h3>Evolución diaria</h3><span>Últimos 14 días con actividad</span></div>
            <canvas id="chartDiario" height="150"></canvas>
          </article>
          <article class="card chart-card">
            <div class="card-heading"><h3>Top agentes</h3><span>Hasta 5 posiciones</span></div>
            <canvas id="chartAgentes" height="190"></canvas>
          </article>
          <article class="card chart-card">
            <div class="card-heading"><h3>Estado de comercios</h3><span>Gestión de adhesión y señalización</span></div>
            <canvas id="chartComercios" height="190"></canvas>
          </article>
        </div>
      </section>
    </main>

    <footer>
      <strong>PONCHO 2026</strong>
      <span>Equipo NOA Oeste · Medios de Pago · BNA</span>
    </footer>
  </div>

  <div class="app-modal" id="appModal" hidden aria-hidden="true">
    <div class="modal-backdrop" data-modal-close></div>
    <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-visual" id="modalVisual" aria-hidden="true">✓</div>
      <h2 id="modalTitle">Operación realizada</h2>
      <p id="modalMessage"></p>
      <div class="modal-actions">
        <button class="btn btn-primary" id="modalAccept" type="button">Aceptar</button>
      </div>
    </section>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>
